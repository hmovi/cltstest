 .v3{background:var(--ink);color:var(--paper)}
 
 .contact-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(1.5rem,4vw,3.5rem);align-items:start}
-form{background:var(--mist);border-radius:32px;padding:clamp(1.5rem,4vw,2.75rem);display:grid;gap:1.1rem}
-label{display:grid;gap:.4rem;font-weight:600;font-size:1rem}
-input,select,textarea{font:inherit;font-weight:400;padding:.9rem 1.1rem;border-radius:16px;border:1.5px solid transparent;background:var(--paper);color:var(--ink);width:100%}
-input:focus,select:focus,textarea:focus{outline:none;border-color:var(--ink)}
-textarea{min-height:150px;resize:vertical}
-.form-note{font-size:.95rem;min-height:1.4em}
+.contact-card{background:var(--mist);border-radius:32px;padding:clamp(1.5rem,4vw,2.75rem);display:grid;gap:1rem}
+.contact-card h2{font-size:clamp(1.8rem,3.4vw,2.6rem);letter-spacing:-.03em;line-height:1.05}
+.contact-card>p{margin-bottom:.5rem;max-width:34em}
+.cc-row{display:flex;align-items:center;gap:1.1rem;padding:1.1rem 1.3rem;border-radius:24px;background:var(--paper);color:var(--ink);text-decoration:none;box-shadow:inset 0 0 0 1.5px transparent;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
+.cc-row:hover{transform:translateY(-3px);box-shadow:inset 0 0 0 1.5px var(--ink),0 14px 30px rgba(31,31,31,.1)}
+.cc-ic{flex:0 0 auto;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--paper)}
+.cc-ic svg{width:22px;height:22px}
+.cc-txt{min-width:0}.cc-txt small{display:block;font-size:.8rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--sand-deep)}
+.cc-txt b{display:block;font-size:clamp(1.1rem,2.2vw,1.4rem);font-weight:700;overflow-wrap:anywhere}
+.foot-contact{line-height:1.8}
 .info{display:grid;gap:1rem}
 .info .tile{min-height:0;gap:.5rem;padding:1.6rem 1.8rem;border-radius:24px;box-shadow:inset 0 0 0 1.5px var(--line)}
 .info .tile strong{font-size:1.25rem}
